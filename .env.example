# The Bioscope.
#
# Every value in this file is a PLACEHOLDER and most are deliberately EMPTY.
# Copy this to `.env` (which is git-ignored) and fill in only what you need.
# Never commit a key that holds anything.
#
# Nothing below is required to run the demo, the tests, or the seed script.
# Only real testnet settlement needs a key and a facilitator.
#
# ---------------------------------------------------------------------------
# Payment mode
# ---------------------------------------------------------------------------
# Which unlock path the server offers. The server reads this; it is not a
# client-supplied flag and the client cannot talk it up to "real".
#
#   simulated  - the default. No chain is touched and no funds move. The UI
#                says so in as many words. Use this for the demo and tests.
#   testnet    - real x402 payment on Base Sepolia. Requires RECIPIENT and
#                FACILITATOR_URL below. Only pick this with a funded
#                test-only key.
BIOSCOPE_PAYMENT_MODE=simulated

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787

# The public origin of this server. The x402 Sign-In-With-X challenge binds the
# wallet signature to this value, and the server refuses a challenge whose
# domain or URI does not match it. It must be the address a browser actually
# uses, not the upstream listener behind a proxy.
BIOSCOPE_ORIGIN=http://localhost:8787

# ---------------------------------------------------------------------------
# Prices, in integer base units. Never floating point.
# ---------------------------------------------------------------------------
# USDC on Base Sepolia has 6 decimals, so 1 base unit = 0.000001 USDC.
# REEL_PRICE_ATOMIC=1000 is 0.001 USDC. A real "one small coin".
BIOSCOPE_REEL_PRICE_ATOMIC=1000

# Where the coins go. Your Base Sepolia address. PLACEHOLDER - leave empty and
# the server runs in simulated mode with no recipient.
BIOSCOPE_RECIPIENT_ADDRESS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The purchase ledger (SQLite, via the node:sqlite builtin - no native module).
BIOSCOPE_DB_PATH=./data/bioscope.db

# Root of the frame store, holding two directories:
#
#   public-frames/<reelId>/frame-000.svg   the FREE peek. Frame 0 only.
#   paid-frames/<reelId>/frame-001.svg     ... and every later frame, paid.
#
# `public-frames` is a directory name, not a web root. NOTHING under this root is
# ever mounted with express.static: every frame is returned by a route handler
# through the media store in src/media/frame-store.ts, which serves frame 0 to the
# free path and refuses every other index. `paid-frames` is read only by the
# x402-gated handler, so a paid frame has no URL to guess at.
#
# `npm run seed` draws every frame. It needs no credentials and no network.
BIOSCOPE_STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# Testnet settlement - ONLY needed when BIOSCOPE_PAYMENT_MODE=testnet
# ---------------------------------------------------------------------------
# The facilitator that understands eip155:84532. Required in testnet mode.
# Empty here on purpose.
BIOSCOPE_FACILITATOR_URL=

# A Base Sepolia key holding TEST USDC ONLY. 0x followed by 64 hex characters.
# Empty here on purpose. Put it in `.env`, never in this file.
#
# The SERVER does not need this and does not ask for it: an x402 client signs the
# payment payload and the facilitator verifies it, so this process only ever
# receives a payload. It is read anyway so that a paying client in the same
# process has it to hand, and so a missing key is reported at startup rather than
# discovered at the first payment.

# ---------------------------------------------------------------------------
# Sign-in (x402 Sign-In-With-X / CAIP-122)
# ---------------------------------------------------------------------------
# How long a sign-in challenge stays valid. The server stamps this expiry into
# the challenge, refuses an expired one, and burns the nonce on first use so a
# captured signature cannot be replayed.
BIOSCOPE_SIWX_EXPIRATION_SECONDS=300

# How long a sign-in session lasts. A session is minted by ONE verified signature
# and then stands in for further signatures, so a returning viewer watches a whole
# bought reel without touching their wallet again. It is identity, never
# entitlement: every paid frame still checks the purchase ledger for
# (this wallet, this reel). Allowed range 60..86400; refused at boot otherwise.
BIOSCOPE_SESSION_TTL_SECONDS=900

# There is deliberately NO key here for verifying wallet signatures, and none for
# sessions either: a session token is random bytes generated by the server, and
# only its SHA-256 is stored. The signature check is a real secp256k1 recovery
# done in-process by the x402 SDK (viem), against a challenge bound to
# BIOSCOPE_ORIGIN above - it needs no secret and no RPC, and there is no setting
# that turns it off. The only keys this project ever creates are the throwaway
# ones the test suite generates at run time, which are never written anywhere.
