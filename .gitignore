node_modules/

# Real local configuration. This is where the funded Base Sepolia key and the
# facilitator URL live. Never committed.
.env
.env.*
!.env.example

# The purchase ledger. Rebuildable with `npm run seed`; holds wallet addresses
# and payment records, so it is not tracked.
data/

# Placeholder frames are generated by the seed script, so the generated media is
# not tracked either. The directories themselves are kept via .gitkeep.
storage/public-frames/*
!storage/public-frames/.gitkeep
storage/paid-frames/*
!storage/paid-frames/.gitkeep

# Local run artefacts
*.log
record/

# `public/` holds the browser UI and IS tracked - it is three hand-written files and
# a type declaration, with no build step and nothing generated. If a media file ever
# appears there, `tests/ui-shell.test.ts` and `tests/private-media.test.ts` both fail,
# which is the guard that matters; a line here would only hide the mistake.

# --- internal documents, not part of the public tree ---
